{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": { "noExplicitAny": "error" },
			"style": {
				"noDefaultExport": "off",
				"noNonNullAssertion": "error",
				"useImportType": "error"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"javascript": {
		"formatter": { "quoteStyle": "double", "semicolons": "asNeeded" }
	},
	"files": {
		"includes": ["**", "!**/node_modules", "!**/dist", "!**/coverage"]
	}
}
