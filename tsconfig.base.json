{
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"], "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true, "verbatimModuleSyntax": true,
    "isolatedModules": true, "skipLibCheck": true, "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true, "noEmit": true, "jsx": "react-jsx"
  }
}
